{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sensei-living-overworld-planner-import-v1",
  "title": "Sensei Living Overworld Planner Import",
  "type": "object",
  "required": ["format", "schemaVersion", "referenceCanvas", "instances"],
  "properties": {
    "format": { "const": "sensei-living-overworld-planner-import" },
    "schemaVersion": { "const": 1 },
    "layoutName": { "type": "string" },
    "plannerNotes": { "type": "string" },
    "referenceCanvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": { "width": { "const": 1920 }, "height": { "const": 300 } }
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assetId", "x", "y"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "assetId": { "type": "string", "minLength": 1 },
          "displayLabel": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "placementAnchor": { "type": "string" },
          "scale": { "type": "number", "exclusiveMinimum": 0 },
          "rotation": { "type": "number" },
          "flipX": { "type": "boolean" },
          "flipY": { "type": "boolean" },
          "visible": { "type": "boolean" },
          "locked": { "type": "boolean" },
          "placeholder": { "type": "boolean" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
